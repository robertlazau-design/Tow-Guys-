{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/blog-post.ts": { "includeFiles": "dist/blog.html" }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/what-to-do-after-a-minor-car-accident-in-gresham",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog", "destination": "/api/blog-post" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/services/:slug", "destination": "/services/:slug.html" },
    { "source": "/towing/:city", "destination": "/towing/:city.html" }
  ]
}
