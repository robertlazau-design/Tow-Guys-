{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/what-to-do-after-a-minor-car-accident-in-gresham",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/services/:slug", "destination": "/services/:slug.html" },
    { "source": "/towing/:city", "destination": "/towing/:city.html" }
  ]
}
